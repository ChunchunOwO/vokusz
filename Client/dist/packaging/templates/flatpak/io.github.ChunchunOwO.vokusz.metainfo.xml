<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ChunchunOwO.vokusz</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Vokusz</name>
  <summary>Chat with communities on Accord servers</summary>
  <developer id="io.github.Vokusz"><name>Vokusz</name></developer>
  <description>
    <p>Vokusz is a community chat client for Accord servers. Connect to your server to send messages and share voice, video, and your screen.</p>
    <p>The app supports multiple accounts, channels, forums, file sharing, and moderation tools.</p>
  </description>
  <launchable type="desktop-id">io.github.ChunchunOwO.vokusz.desktop</launchable>
  <url type="homepage">https://github.com/ChunchunOwO/vokusz</url>
  <url type="bugtracker">https://github.com/ChunchunOwO/vokusz/issues</url>
  <url type="vcs-browser">https://github.com/ChunchunOwO/vokusz</url>
  <provides><binary>vokusz</binary><mediatype>x-scheme-handler/vokusz</mediatype></provides>
  <content_rating type="oars-1.1"><content_attribute id="social-chat">intense</content_attribute></content_rating>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ChunchunOwO/vokusz/@@TAG@@/store-media/screenshots-tablet/tablet-01.png</image>
      <caption>Vokusz community messaging on a tablet</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="@@VERSION@@" date="@@RELEASE_DATE@@">
      <url>https://github.com/ChunchunOwO/vokusz/releases/tag/@@TAG@@</url>
      <description><p>See the linked release notes for changes in this version.</p></description>
    </release>
  </releases>
</component>
