    <ResourceDictionary x:Key="Light">
      <!-- Fluent binds this directly in its template; keep the semantic text color at full contrast. -->
      <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
      <SolidColorBrush x:Key="WallpaperScrimBrush">#FFFFFF</SolidColorBrush>
