<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>vokusz</id>
    <version>@@VERSION@@</version>
    <title>Vokusz</title>
    <authors>Vokusz</authors>
    <projectUrl>https://github.com/ChunchunOwO/vokusz</projectUrl>
    <licenseUrl>https://github.com/ChunchunOwO/vokusz/blob/@@TAG@@/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/ChunchunOwO/vokusz</projectSourceUrl>
    <bugTrackerUrl>https://github.com/ChunchunOwO/vokusz/issues</bugTrackerUrl>
    <tags>chat messaging voice video communities</tags>
    <summary>Chat, voice, video, and screen sharing for Vokusz communities</summary>
    <description>Vokusz connects to Accord servers for community messaging, voice, video, and screen sharing. This package installs the x64 Windows application.</description>
    <releaseNotes>https://github.com/ChunchunOwO/vokusz/releases/tag/@@TAG@@</releaseNotes>
  </metadata>
  <files><file src="tools\**" target="tools" /></files>
</package>
